# CodeNova Environment Configuration Example
# Copy this file to .env and update with your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application name
APP_NAME=CodeNova

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (true/false) - MUST be false in production
DEBUG=true

# API version
API_VERSION=v1

# Server configuration
HOST=0.0.0.0
PORT=8000

# Base URLs
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://codenova:your_password@localhost:5432/codenova_dev

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection string
# Format: redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Redis connection settings
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Secret key for JWT tokens
# IMPORTANT: Generate a secure random key for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password settings
PASSWORD_HASH_ALGORITHM=bcrypt
PASSWORD_MIN_LENGTH=8

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=*

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048
GEMINI_TIMEOUT=30

# AI service settings
AI_MAX_RETRIES=3
AI_RETRY_DELAY=2
AI_RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# Storage type (local, s3, spaces)
STORAGE_TYPE=local

# Local storage settings
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_MAX_SIZE_MB=5

# Digital Ocean Spaces (if using)
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=codenova-files
SPACES_ACCESS_KEY=your-spaces-access-key
SPACES_SECRET_KEY=your-spaces-secret-key
SPACES_PUBLIC_URL=https://codenova-files.nyc3.digitaloceanspaces.com

# AWS S3 (if using)
AWS_REGION=us-east-1
AWS_S3_BUCKET=codenova-files
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# File upload limits
MAX_FILE_SIZE_MB=5
MAX_BATCH_SIZE=20
MAX_BATCH_TOTAL_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=.py,.js,.ts,.jsx,.tsx,.java,.cpp,.c,.cs,.go,.rs,.php,.rb,.swift,.kt,.scala

# =============================================================================
# BACKGROUND JOB CONFIGURATION
# =============================================================================

# Celery broker and backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Worker settings
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# Task settings
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true

# Queue names
CELERY_QUEUE_DEFAULT=default
CELERY_QUEUE_ANALYSIS=analysis
CELERY_QUEUE_NOTIFICATIONS=notifications

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# Enable/disable email
SMTP_ENABLED=false

# SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@codenova.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=noreply@codenova.com
SMTP_FROM_NAME=CodeNova

# Email templates
EMAIL_TEMPLATES_DIR=./templates/email

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log format (json, text)
LOG_FORMAT=json

# File logging
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/app.log
LOG_FILE_MAX_SIZE_MB=100
LOG_FILE_BACKUP_COUNT=10

# Sentry error tracking (optional)
SENTRY_ENABLED=false
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Health check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# APM (Application Performance Monitoring)
APM_ENABLED=false
APM_SERVICE_NAME=codenova-api
APM_SERVER_URL=http://apm-server:8200

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable features
FEATURE_FILE_UPLOAD=true
FEATURE_BATCH_ANALYSIS=true
FEATURE_FEEDBACK_SYSTEM=true
FEATURE_ANALYTICS=true
FEATURE_ADMIN_DASHBOARD=true
FEATURE_TEAM_MANAGEMENT=true
FEATURE_AUDIT_LOGS=true

# =============================================================================
# DEVELOPMENT SETTINGS (Development only)
# =============================================================================

# Auto-reload on code changes
AUTO_RELOAD=true

# Show detailed error pages
SHOW_ERROR_DETAILS=true

# Disable authentication (for testing only)
DISABLE_AUTH=false

# Mock external services
MOCK_AI_SERVICE=false
MOCK_EMAIL_SERVICE=false

# =============================================================================
# PRODUCTION SETTINGS (Production only)
# =============================================================================

# These should only be set in production

# Force HTTPS
# FORCE_HTTPS=true

# Strict transport security
# HSTS_ENABLED=true
# HSTS_MAX_AGE=31536000

# Content security policy
# CSP_ENABLED=true

# Database SSL
# DB_SSL_MODE=require

# Redis SSL
# REDIS_SSL=true

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit this file with real credentials to version control
# 2. Use strong, unique passwords for production
# 3. Rotate secrets regularly (every 90 days)
# 4. Store production secrets in a secure vault (AWS Secrets Manager, etc.)
# 5. Use different values for each environment (dev, staging, prod)
# 6. Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# 7. Test configuration with: python -c "from app.core.config import settings; print('✓ Config valid')"

# =============================================================================
# QUICK START
# =============================================================================

# 1. Copy this file:
#    cp .env.example .env

# 2. Update required values:
#    - DATABASE_URL
#    - SECRET_KEY
#    - GEMINI_API_KEY

# 3. Start the application:
#    python app/main.py

# 4. Verify configuration:
#    curl http://localhost:8000/health
